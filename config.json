{
  "secrets_file": "secrets/credentials.json",
  "network": {
    "proxy": null
  },
  "env": {
    "MALLOC_ARENA_MAX": "2",
    "PYTHONUNBUFFERED": "1"
  },
  "logging": {
    "level": "INFO",
    "file": "logs/bridge.log",
    "max_bytes": 10485760,
    "backups": 5
  },
